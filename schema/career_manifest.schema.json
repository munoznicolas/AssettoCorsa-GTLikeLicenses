{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GTLicenseCareerManifest",
  "description": "Schema for Content Manager career series definition",
  "type": "object",
  "required": ["series_code", "name", "description", "tier", "events"],
  "properties": {
    "series_code": { "type": "string" },
    "requires_code": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "tier": { "type": "string" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_index", "test_id", "test_file"],
        "properties": {
          "event_index": { "type": "integer" },
          "test_id": { "type": "string" },
          "test_file": { "type": "string" }
        }
      }
    }
  }
}
