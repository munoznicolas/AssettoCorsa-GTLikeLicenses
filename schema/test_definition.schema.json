{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GTLicenseTestDefinition",
  "description": "Schema for a single Gran Turismo-style license test in Assetto Corsa",
  "type": "object",
  "required": [
    "test_id",
    "tier",
    "title",
    "description",
    "lesson_objective",
    "car_id",
    "track_id",
    "track_layout",
    "start_mode",
    "spawn",
    "timing",
    "fail_rules",
    "targets"
  ],
  "properties": {
    "test_id": {
      "type": "string",
      "pattern": "^(B|A|IB|IA|S)-([0-9]{1,2})$",
      "description": "Identifier like B-1, A-12, IB-5, S-10"
    },
    "tier": {
      "type": "string",
      "enum": [
        "National B",
        "National A",
        "International B",
        "International A",
        "Super License"
      ]
    },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string" },
    "lesson_objective": { "type": "string" },
    "car_id": {
      "type": "string",
      "description": "Exact folder ID in content/cars"
    },
    "track_id": {
      "type": "string",
      "description": "Exact folder ID in content/tracks"
    },
    "track_layout": {
      "type": "string",
      "description": "Layout subfolder or empty string for default layout"
    },
    "start_mode": {
      "type": "string",
      "enum": ["STANDING", "ROLLING", "FLYING_LAP"]
    },
    "spawn": {
      "type": "object",
      "required": ["position", "forward_vector", "initial_speed_kmh"],
      "properties": {
        "position": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z] world coordinates in meters"
        },
        "forward_vector": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "[dx, dy, dz] normalized heading vector"
        },
        "initial_speed_kmh": {
          "type": "number",
          "minimum": 0,
          "description": "Initial speed in km/h (0 for standing start)"
        }
      }
    },
    "timing": {
      "type": "object",
      "required": ["start_gate", "finish_gate"],
      "properties": {
        "start_gate": {
          "type": "object",
          "required": ["p1", "p2"],
          "properties": {
            "p1": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
            "p2": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
          }
        },
        "finish_gate": {
          "type": "object",
          "required": ["p1", "p2"],
          "properties": {
            "p1": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
            "p2": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
          }
        },
        "stop_box": {
          "type": "object",
          "description": "Bounding box for acceleration & braking tests",
          "required": ["center", "size", "rotation_deg"],
          "properties": {
            "center": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
            "size": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
            "rotation_deg": { "type": "number" }
          }
        }
      }
    },
    "fail_rules": {
      "type": "object",
      "required": [
        "max_wheels_off",
        "wall_collision_threshold_n",
        "max_yaw_angle_deg"
      ],
      "properties": {
        "max_wheels_off": { "type": "integer", "minimum": 1, "maximum": 4, "default": 2 },
        "wall_collision_threshold_n": { "type": "number", "minimum": 100, "default": 1500 },
        "max_yaw_angle_deg": { "type": "number", "minimum": 30, "maximum": 180, "default": 90 },
        "stop_box_overshoot_fail": { "type": "boolean", "default": false }
      }
    },
    "targets": {
      "type": "object",
      "required": ["gold_seconds", "silver_seconds", "bronze_seconds"],
      "properties": {
        "gold_seconds": { "type": "number", "minimum": 1.0 },
        "silver_seconds": { "type": "number", "minimum": 1.0 },
        "bronze_seconds": { "type": "number", "minimum": 1.0 }
      }
    }
  }
}
